Option Explicit
Public Function ToolSpecIds() As Variant
    ToolSpecIds = Array("capBlocks", "capBlockRandom", "capCensus", "capPareto", "capHeatmap", "capRepeat", "capHotStreets", "capTrends", "capCompare", "capProfile", "capCrosswalk", "capSingleSite", "capYoY", "capSeasonality", "capCheck", "capReview")
End Function
Public Function ToolSpec(ByVal toolId As String) As Object
    Dim spec As Object, fields As Collection, options As Collection
    Set spec = CreateObject("Scripting.Dictionary"): Set fields = New Collection: Set options = New Collection
    spec.Add "Id", toolId: spec.Add "Roles", fields: spec.Add "Options", options
    spec.Add "Preparation", (toolId = "capBlocks" Or toolId = "capBlockRandom" Or toolId = "capCensus")
    Select Case toolId
        Case "capBlocks"
            spec.Add "Title", "Hundred-Block Builder": spec.Add "Description", "Copy selected data and add hundred-block addresses."
            AddSetupRole fields, "ADDRESS", "Address", True, "Address|Full Address|CAP_SyntheticAddress", "Street address; include units when relevant."
        Case "capBlockRandom"
            spec.Add "Title", "Randomize Block Addresses": spec.Add "Description", "Create labelled synthetic addresses within agency hundred blocks."
            AddSetupRole fields, "ADDRESS", "Address", True, "Address|Full Address|CAP_SyntheticAddress", "Street address; include units when relevant."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "CITY", "City", False, "City", "Distinguishes identical locations across cities."
            AddSetupRole fields, "STATE", "State", False, "State", "US state abbreviation."
            AddSetupOption options, "SEED", "Seed", "text", "", "20261013"
        Case "capCensus"
            spec.Add "Title", "Census Geocoder": spec.Add "Description", "Map Address plus City and State, or Address plus ZIP."
            AddSetupRole fields, "ADDRESS", "Address", True, "Address|Full Address|CAP_SyntheticAddress", "Street address; include units when relevant."
            AddSetupRole fields, "CITY", "City", False, "City", "Distinguishes identical locations across cities."
            AddSetupRole fields, "STATE", "State", False, "State", "US state abbreviation."
            AddSetupRole fields, "ZIP", "ZIP", False, "ZIP|ZipCode|Postal Code", "Optional with City and State; repairs are flagged."
        Case "capPareto"
            spec.Add "Title", "Crime Concentration": spec.Add "Description", "Measure concentration among blocks with the selected recorded crime."
            AddSetupRole fields, "HUNDRED-BLOCK", "Hundred Block", True, "CAP_HundredBlock|HundredBlock", "A block address or qualified street identifier."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "CITY", "City", False, "City", "Distinguishes identical locations across cities."
            AddSetupRole fields, "STATE", "State", False, "State", "US state abbreviation."
            AddSetupRole fields, "LOCATION LABEL", "Location label", False, "", "Optional readable name; use a separate field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
        Case "capHeatmap"
            spec.Add "Title", "Temporal Heat Map": spec.Add "Description", "Compare Monday-Sunday against hours 0-23."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "TIME", "Time", False, "Time|Time Only", "A separate time field; unknown times are excluded."
            AddSetupRole fields, "HOUR", "Hour (0-23)", False, "Hour (0-23)|Hour from Time (0-23)", "Whole hour from 0 through 23."
            AddSetupRole fields, "DAY OF WEEK", "Day of Week", False, "Day of Week", "Monday-Sunday or Mon-Sun text."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupOption options, "TIME INPUT", "Time input", "list", "Date or timestamp|Date plus separate Time|Day of Week plus Hour|Day of Week plus Time", "Date plus separate Time"
        Case "capRepeat"
            spec.Add "Title", "Repeat Locations": spec.Add "Description", "Rank repeat addresses; dates and times are not required."
            AddSetupRole fields, "ADDRESS", "Address", True, "Address|Full Address|CAP_SyntheticAddress", "Street address; include units when relevant."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "LOCATION LABEL", "Location label", False, "", "Optional readable name; use a separate field."
            AddSetupRole fields, "CITY", "City", False, "City", "Distinguishes identical locations across cities."
            AddSetupRole fields, "STATE", "State", False, "State", "US state abbreviation."
        Case "capHotStreets"
            spec.Add "Title", "Hot Streets": spec.Add "Description", "Compare street activity over time; intervals and minimum events stay on the report."
            AddSetupRole fields, "HUNDRED-BLOCK", "Hundred Block", True, "CAP_HundredBlock|HundredBlock", "A block address or qualified street identifier."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "LOCATION LABEL", "Location label", False, "", "Optional readable name; use a separate field."
            AddSetupRole fields, "CITY", "City", False, "City", "Distinguishes identical locations across cities."
            AddSetupRole fields, "STATE", "State", False, "State", "US state abbreviation."
        Case "capTrends"
            spec.Add "Title", "Monthly / Annual Trends": spec.Add "Description", "Report counts and change across months or years."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "LOCATION", "Location", False, "CAP_HundredBlock|Address", "Use a jurisdiction-qualified location key."
            AddSetupOption options, "CRIME FILTER", "Crime filter", "list", "All crime types", "All crime types"
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "START", "Start date", "text", "", ""
            AddSetupOption options, "END", "End date", "text", "", ""
            AddSetupOption options, "UNIT", "Interval", "list", "Months|Years", "Months"
        Case "capCompare"
            spec.Add "Title", "Period Comparison": spec.Add "Description", "Compare two non-overlapping periods; Period A must precede Period B."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "LOCATION", "Location", False, "CAP_HundredBlock|Address", "Use a jurisdiction-qualified location key."
            AddSetupOption options, "CRIME FILTER", "Crime filter", "list", "All crime types", "All crime types"
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "A START", "Period A start", "text", "", ""
            AddSetupOption options, "A END", "Period A end", "text", "", ""
            AddSetupOption options, "START", "Start date / Period B start", "text", "", ""
            AddSetupOption options, "END", "End date / Period B end", "text", "", ""
        Case "capProfile"
            spec.Add "Title", "Crime Profile": spec.Add "Description", "Summarize crime mix, coverage and repeated locations."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "LOCATION", "Location", False, "CAP_HundredBlock|Address", "Use a jurisdiction-qualified location key."
            AddSetupOption options, "CRIME FILTER", "Crime filter", "list", "All crime types", "All crime types"
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "START", "Start date", "text", "", ""
            AddSetupOption options, "END", "End date", "text", "", ""
        Case "capCrosswalk"
            spec.Add "Title", "Prepare NIBRS Crosswalk": spec.Add "Description", "Prepare proposed NIBRS mappings for analyst review and approval."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "AGENCY", "Agency", False, "Agency", "Keeps agency-specific crosswalk entries separate."
            AddSetupOption options, "FEDERAL", "Federal/tribal reporting", "list", "No|Yes", "No"
        Case "capSingleSite"
            spec.Add "Title", "Single Site": spec.Add "Description", "Count eligible crime near one site within 0.25, 0.5 and 1 mile."
            AddSetupRole fields, "LATITUDE", "Incident latitude", True, "Latitude|Lat", "Incident latitude in decimal degrees."
            AddSetupRole fields, "LONGITUDE", "Incident longitude", True, "Longitude|Lon|Long", "Incident longitude in decimal degrees."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "DATE", "Date", False, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupOption options, "SITE LAT", "Site latitude", "text", "", ""
            AddSetupOption options, "SITE LON", "Site longitude", "text", "", ""
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "START", "Start date", "text", "", ""
            AddSetupOption options, "END", "End date", "text", "", ""
        Case "capYoY"
            spec.Add "Title", "Year over Year": spec.Add "Description", "Compare monthly or annual activity with the prior year."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "START", "Start date", "text", "", ""
            AddSetupOption options, "END", "End date", "text", "", ""
            AddSetupOption options, "UNIT", "Interval", "list", "Months|Years", "Months"
        Case "capSeasonality"
            spec.Add "Title", "Seasonality": spec.Add "Description", "Compare calendar-month patterns across years."
            AddSetupRole fields, "DATE", "Date", True, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", True, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupOption options, "MEASURE", "Count measure", "list", "Unique incidents|Source records", "Source records"
            AddSetupOption options, "START", "Start date", "text", "", ""
            AddSetupOption options, "END", "End date", "text", "", ""
        Case "capCheck"
            spec.Add "Title", "Dataset Check + Coverage": spec.Add "Description", "Check selected data; all field mappings are optional."
            AddSetupRole fields, "DATE", "Date", False, "Date|OccurredAt|Date Only", "US month/day/year or ISO; Excel dates supported."
            AddSetupRole fields, "CRIME", "Crime Type", False, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
            AddSetupRole fields, "INCIDENTID", "Incident ID", False, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "ADDRESS", "Address", False, "Address|Full Address|CAP_SyntheticAddress", "Street address; include units when relevant."
            AddSetupRole fields, "LATITUDE", "Incident latitude", False, "Latitude|Lat", "Incident latitude in decimal degrees."
            AddSetupRole fields, "LONGITUDE", "Incident longitude", False, "Longitude|Lon|Long", "Incident longitude in decimal degrees."
        Case "capReview"
            spec.Add "Title", "Duplicate / Case Review": spec.Add "Description", "Review duplicates and offenses associated with each incident; rows are retained."
            AddSetupRole fields, "INCIDENTID", "Incident ID", True, "IncidentID|Incident ID", "Stable ID; qualify across agencies and years."
            AddSetupRole fields, "CRIME", "Crime Type", False, "CrimeType|Crime Type|Offense", "The offense or crime classification field."
        Case Else: Err.Raise vbObjectError + 1200, , "Unknown setup tool."
    End Select
    Set ToolSpec = spec
End Function
Private Sub AddSetupRole(ByVal fields As Collection, ByVal key As String, ByVal label As String, ByVal required As Boolean, ByVal suggested As String, ByVal help As String)
    Dim role As Object
    Set role = CreateObject("Scripting.Dictionary")
    role.Add "Key", key: role.Add "Label", label: role.Add "Required", required: role.Add "Suggested", suggested: role.Add "Help", help
    fields.Add role
End Sub
Private Sub AddSetupOption(ByVal options As Collection, ByVal key As String, ByVal label As String, ByVal kind As String, ByVal choices As String, ByVal defaultValue As String)
    Dim item As Object
    Set item = CreateObject("Scripting.Dictionary")
    item.Add "Key", key: item.Add "Label", label: item.Add "Kind", kind: item.Add "Choices", choices: item.Add "Default", defaultValue
    options.Add item
End Sub
