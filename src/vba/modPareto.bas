Attribute VB_Name = "modPareto"
Option Explicit

Public Function AggregateBlocks(ByVal a As Variant, ByVal idCol As Long, ByVal blockCol As Long, ByRef missingRows As Long, ByRef excludedIDs As Long, ByRef totalIDs As Long) As Object
    Dim blocks As Object, ids As Object, i As Long, id As String, b As String, k As Variant, v As Variant
    Set blocks = CreateObject("Scripting.Dictionary"): Set ids = CreateObject("Scripting.Dictionary")
    missingRows = 0: excludedIDs = 0: totalIDs = 0
    For i = 2 To UBound(a, 1)
        id = SafeText(a(i, idCol)): b = SafeText(a(i, blockCol))
        If IsError(a(i, blockCol)) Then b = ""
        If Len(b) = 0 Then
            missingRows = missingRows + 1
        Else
            If Not blocks.Exists(b) Then blocks.Add b, Array(0&, 0&)
            v = blocks(b): v(0) = v(0) + 1: blocks(b) = v
        End If
        If Len(id) > 0 And Not IsError(a(i, idCol)) Then
            If Not ids.Exists(id) Then
                ids.Add id, b
            ElseIf ids(id) <> b Then
                ids(id) = ""
            End If
        End If
    Next
    totalIDs = ids.Count
    For Each k In ids.Keys
        b = ids(k)
        If Len(b) = 0 Then
            excludedIDs = excludedIDs + 1
        Else
            v = blocks(b): v(1) = v(1) + 1: blocks(b) = v
        End If
    Next
    Set AggregateBlocks = blocks
End Function

Public Sub SortConcentration(ByRef rows As Variant, ByVal first As Long, ByVal last As Long)
    Dim lo As Long, hi As Long, pivot As Long, pivotKey As String, tmp As Variant, j As Long
    lo = first: hi = last
    pivot = rows((first + last) \ 2, 2): pivotKey = rows((first + last) \ 2, 1)
    Do While lo <= hi
        Do While rows(lo, 2) > pivot Or (rows(lo, 2) = pivot And StrComp(rows(lo, 1), pivotKey, vbBinaryCompare) < 0)
            lo = lo + 1
        Loop
        Do While rows(hi, 2) < pivot Or (rows(hi, 2) = pivot And StrComp(rows(hi, 1), pivotKey, vbBinaryCompare) > 0)
            hi = hi - 1
        Loop
        If lo <= hi Then
            For j = 1 To UBound(rows, 2)
                tmp = rows(lo, j): rows(lo, j) = rows(hi, j): rows(hi, j) = tmp
            Next
            lo = lo + 1: hi = hi - 1
        End If
    Loop
    If first < hi Then SortConcentration rows, first, hi
    If lo < last Then SortConcentration rows, lo, last
End Sub

Public Sub BuildPareto(Optional ByVal source As Range, Optional ByVal incidentHeader As String = "IncidentID", Optional ByVal blockHeader As String = "CAP_BlockKey", Optional ByVal countMeasure As String = "INCIDENTS")
    On Error GoTo failed
    Dim r As Range, a As Variant, ic As Long, bc As Long, blocks As Object, ws As Worksheet
    Dim missing As Long, excluded As Long, ids As Long, measure As Variant, ix As Long, eligible As Long, missingIDRows As Long
    Dim k As Variant, v As Variant, rows() As Variant, n As Long, i As Long, total As Long, cum As Long
    Dim topN As Long, topShare As Double, reach As Long, threshold As Long, tieEnd As Long
    Set r = source
    If r Is Nothing Then Set r = PickSource()
    If r Is Nothing Then Exit Sub
    a = r.Value2
    If source Is Nothing Then
        ic = AskColumn(a, "Stable incident key (agency/year/case as needed).", "IncidentID", False, "INCIDENTID")
        bc = AskColumn(a, "Hundred-block key generated by the toolkit.", "CAP_BlockKey", False, "HUNDRED-BLOCK")
        measure = Application.InputBox("Enter INCIDENTS or RECORDS. Records are selected rows, not verified unique offenses. Incident mode excludes IDs with conflicting or missing block keys.", "CAP Index measure", "INCIDENTS", Type:=2)
    Else
        ic = HeaderColumn(a, incidentHeader): bc = HeaderColumn(a, blockHeader): measure = countMeasure
    End If
    If VarType(measure) = vbBoolean Then Exit Sub
    measure = UCase$(Trim$(CStr(measure)))
    If measure <> "INCIDENTS" And measure <> "RECORDS" Then Err.Raise vbObjectError + 20, , "Choose INCIDENTS or RECORDS."
    ix = IIf(measure = "INCIDENTS", 1, 0)
    Set blocks = AggregateBlocks(a, ic, bc, missing, excluded, ids)
    For i = 2 To UBound(a, 1)
        If IsError(a(i, ic)) Or Len(SafeText(a(i, ic))) = 0 Then missingIDRows = missingIDRows + 1
    Next
    i = 0
    For Each k In blocks.Keys
        v = blocks(k)
        If v(ix) > 0 Then n = n + 1: total = total + v(ix)
    Next
    If n = 0 Then Err.Raise vbObjectError + 21, , "No eligible blocks for the selected measure."
    ReDim rows(1 To n, 1 To 7)
    For Each k In blocks.Keys
        v = blocks(k)
        If v(ix) > 0 Then
            i = i + 1: rows(i, 1) = k: rows(i, 2) = v(ix)
        End If
    Next
    SortConcentration rows, 1, n
    topN = -Int(-0.2 * n)
    For i = 1 To n
        cum = cum + rows(i, 2)
        rows(i, 3) = i: rows(i, 4) = rows(i, 2) / total
        rows(i, 5) = cum / total: rows(i, 6) = i / n
        rows(i, 7) = i <= topN
        If i = topN Then topShare = cum / total
        If reach = 0 And cum / total >= 0.8 Then reach = i: threshold = rows(i, 2)
    Next
    tieEnd = reach
    Do While tieEnd < n
        If rows(tieEnd + 1, 2) <> threshold Then Exit Do
        tieEnd = tieEnd + 1
    Loop
    eligible = ids - excluded
    Set ws = NewOutput(r.Parent.Parent, "BlockConcentration", r, "Measure: " & measure & "; denominator: eligible activity on observed populated blocks. Selected period/jurisdiction only. All selected rows retained, including suspected duplicates.")
    ws.Cells(4, 1).Value2 = "Source rows=" & UBound(a, 1) - 1 & "; missing/error block rows=" & missing & "; missing/error ID rows=" & missingIDRows & "; valid IDs=" & ids & "; excluded missing/conflicting block IDs=" & excluded & "; eligible incidents=" & eligible
    ws.Cells(5, 1).Value2 = "Eligible count=" & total & "; blocks=" & n & "; top " & topN & " blocks share=" & Format$(topShare, "0.0%") & "; blocks to 80%=" & reach & "; including boundary ties=" & tieEnd
    WriteHeaders ws, 6, 1, Array("BlockKey", "Count", "Rank", "ActivityShare", "CumulativeActivityShare", "CumulativeBlockShare", "Top20PercentRoundedUp")
    ws.Cells(7, 1).Resize(n, 1).NumberFormat = "@"
    ws.Cells(7, 1).Resize(n, 7).Value2 = rows
    ws.Range("D7:F" & n + 6).NumberFormat = "0.0%"
    FinishOutput ws, n + 6, 7
    Exit Sub
failed: ToolkitError "Hundred-block concentration"
End Sub
